ark.png","previewLight":"https://apps.homeycdn.net/app/nl.lrvdlinden.postnl/47/1bbcd323-5be9-4f20-a9d6-a78a2282b092/widgets/pakket-details/preview-light.png"},"pakket-reis":{"name":{"en":"Parcel Journey","nl":"Reis van je pakket"},"height":420,"api":{"getData":{"method":"GET","path":"/"}},"devices":{"type":"app","singular":true,"filter":{"capabilities":"postnl_package_count"}},"id":"pakket-reis","settings":[],"previewDark":"https://apps.homeycdn.net/app/nl.lrvdlinden.postnl/47/1bbcd323-5be9-4f20-a9d6-a78a2282b092/widgets/pakket-reis/preview-dark.png","previewLight":"https://apps.homeycdn.net/app/nl.lrvdlinden.postnl/47/1bbcd323-5be9-4f20-a9d6-a78a2282b092/widgets/pakket-reis/preview-light.png"}},"screensavers":[],"homeyCommunityTopicId":159674,"state":"live","stateChangedAt":"2026-10-12T14:02:52.437Z","bugs":"https://community.homey.app/t/app-pro-postnl-for-homey/159674","homepage":"https://lrvdlinden.gitbook.io/postnl-for-homey","support":"https://community.homey.app/t/app-pro-postnl-for-homey/159674","source":null,"contributors":null,"contributing":null,"permissions":[],"apiScopes":null,"changelog":{"en":"Fixed the parcel image in Flows showing a Homey logo or failing with \"Missing token value: package_image\". Parcel Flows now use the My Delivery image again, which is set to the triggering parcel and its current status right before the Flow starts, so the image always matches the notification. Images are only drawn for parcels that have not been delivered yet. New global image tokens \"Parcel image\" and \"Latest mail scan\" are always filled and can be used in any Flow, including Advanced Flows with several trigger cards.","nl":"Opgelost dat de pakketafbeelding in Flows een Homey-logo toonde of faalde met \"Missing token value: package_image\". Pakket-Flows gebruiken weer de Mijn Bezorging-afbeelding, die vlak voor de Flow start wordt ingesteld op het pakket en de actuele status van die trigger, zodat de afbeelding altijd bij de melding past. Afbeeldingen worden alleen getekend voor pakketten die nog niet bezorgd zijn. Nieuwe globale afbeeldingstokens \"Pakketafbeelding\" en \"Scan laatste poststuk\" zijn altijd gevuld en bruikbaar in elke Flow, ook in Advanced Flows met meerdere trigger-kaarten."},"compatibility":">=12.3.0","tags":{"en":["postnl","post","mail","letter","letters","mail item","mail items","parcel","parcels","package","packages","package tracking","parcel tracking","delivery","deliveries","shipment","shipments","tracking","track and trace","postal service","postal delivery","my post","my delivery","mailbox","automation","my packages"],"nl":["postnl","post","brief","brieven","poststuk","poststukken","pakket","pakketten","pakket volgen","pakketten volgen","bezorging","bezorgen","zending","zendingen","tracking","track en trace","postbezorging","mijn post","mijn bezorging","brievenbus","automatisering","mijn pakketten"]},"platforms":["local"],"sdk":3,"platformLocalRequiredFeatures":[],"platformLocalOptionalFeatures":[],"runtime":"nodejs"},"liveVersion":"1.2.12","testBuild":null,"testVersion":null,"private":false,"sponsoredUrl":{},"author":{"id":"649eefe59a54fe7531821578","type":"user","userId":"5d4da77a2c836a50f6936070","name":"Léon van der Linden","verified":false}}