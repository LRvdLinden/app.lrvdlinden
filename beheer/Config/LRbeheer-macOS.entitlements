<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- LRbeheer op de Mac (Mac Catalyst; CODE_SIGN_ENTITLEMENTS[sdk=macosx*]). Zelfde Keychain-groepen als iOS.
     Pushmeldingen: com.apple.developer.aps-environment (de macOS-vorm); bij archiveren zet Xcode dit op production.
     Sandbox met netwerk; foto's kiezen gaat via de systeemkiezer, downloads en delen via de standaardvensters. -->
<plist version="1.0">
<dict>
	<key>com.apple.developer.aps-environment</key>
	<string>development</string>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.personal-information.photos-library</key>
	<true/>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)app.lrvdlinden.lrbeheer</string>
		<string>$(AppIdentifierPrefix)app.lrvdlinden.lrbeheer.shared</string>
	</array>
</dict>
</plist>
