          }
        }
      }
    },
    "\"%@\" verwijderen?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete \"%@\"?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" verwijderen?"
          }
        }
      }
    },
    "%@\n\nNaar ongeveer %@ apparaten. Dit kan niet worden teruggedraaid op iPhone en iPad.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\nTo about %2$@ devices. This cannot be undone on iPhone and iPad."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nNaar ongeveer %@ apparaten. Dit kan niet worden teruggedraaid op iPhone en iPad."
          }
        }
      }
    },
    "%@ %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@"
          }
        }
      }
    },
    "%@ %lld heeft geen naam.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$lld has no name."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %lld heeft geen naam."
          }
        }
      }
    },
    "%@ accounts met Lifetime via sandbox": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ accounts with Lifetime via sandbox"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ accounts met Lifetime via sandbox"
          }
        }
      }
    },
    "%@ doet daarna niet meer mee. De zaak krijgt een mail en een melding.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ will no longer take part. The business gets an email and a notification."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ doet daarna niet meer mee. De zaak krijgt een mail en een melding."
          }
        }
      }
    },
    "%@ echt verwijderen?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Really delete %@?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ echt verwijderen?"
          }
        }
      }
    },
    "%@ is toegevoegd bovenaan je portfolio. Controleer de labels en tekst en publiceer daarna.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ was added at the top of your portfolio. Check the labels and text, then publish."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is toegevoegd bovenaan je portfolio. Controleer de labels en tekst en publiceer daarna."
          }
        }
      }
    },
    "%@ is toegevoegd. Controleer de gegevens, zet eventueel Tonen in Nieuw en onderweg, Alleen Nederlands of een banner aan, en publiceer als je iets aanpast. De app staat al live met een eigen pagina.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has been added. Check the details, optionally turn on Show in New and upcoming, Dutch only or a banner, and publish if you change anything. The app is already live with its own page."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is toegevoegd. Controleer de gegevens, zet eventueel Tonen in Nieuw en onderweg, Alleen Nederlands of een banner aan, en publiceer als je iets aanpast. De app staat al live met een eigen pagina."
          }
        }
      }
    },
    "%@ is verwijderd.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has been deleted."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is verwijderd."
          }
        }
      }
    },
    "%@ kan daarna niet meer worden gescand en nieuwe klanten kunnen geen lid worden.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ can then no longer be scanned and new customers cannot join."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kan daarna niet meer worden gescand en nieuwe klanten kunnen geen lid worden."
          }
        }
      }
    },
    "%@ kan dan niet meer scannen bij %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ can then no longer scan at %2$@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kan dan niet meer scannen bij %@."
          }
        }
      }
    },
    "%@ staat al in je portfolio": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is already in your portfolio"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ staat al in je portfolio"
          }
        }
      }
    },
    "%@ van %@ gaat niet door. Alle tickets vervallen; iedereen die zich aanmeldde krijgt een mail en een melding.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ of %2$@ will not take place. All tickets become invalid; everyone who registered gets an email and a notification."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ van %@ gaat niet door. Alle tickets vervallen; iedereen die zich aanmeldde krijgt een mail en een melding."
          }
        }
      }
    },
    "%@ van %@ mails zijn verstuurd; %@ mislukt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ of %@ emails were sent; %@ failed."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ van %@ mails zijn verstuurd; %@ mislukt."
          }
        }
      }
    },
    "%@ van %@ verstuurd": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ of %2$@ sent"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ van %@ verstuurd"
          }
        }
