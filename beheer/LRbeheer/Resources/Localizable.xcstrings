    "Een betaalde aankoop zonder account aan dit account koppelen. Het account krijgt Lifetime. Doe dit alleen als je zeker weet dat deze klant de koper is.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
