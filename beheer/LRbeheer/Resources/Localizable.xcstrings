  "strings": {
    "\"%@\" verwijderen?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete \"%@\"?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" verwijderen?"
          }
        }
      }
    },
    "%@ %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@"
          }
        }
      }
    },
    "%@ %lld heeft geen naam.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$lld has no name."
