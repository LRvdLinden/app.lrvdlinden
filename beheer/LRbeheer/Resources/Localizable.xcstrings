{
  "sourceLanguage": "nl",
  "version": "1.0",
  "strings": {
    "\"%@\" verwijderen?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete \"%@\"?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" verwijderen?"
          }
        }
      }
    },
    "%@\n\nNaar ongeveer %@ apparaten. Dit kan niet worden teruggedraaid op iPhone en iPad.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\nTo about %2$@ devices. This cannot be undone on iPhone and iPad."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nNaar ongeveer %@ apparaten. Dit kan niet worden teruggedraaid op iPhone en iPad."
          }
        }
      }
    },
    "%@ %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@"
          }
        }
      }
    },
    "%@ %lld heeft geen naam.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$lld has no name."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %lld heeft geen naam."
          }
        }
      }
    },
    "%@ echt verwijderen?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Really delete %@?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ echt verwijderen?"
          }
        }
      }
    },
    "%@ is toegevoegd bovenaan je portfolio. Controleer de labels en tekst en publiceer daarna.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ was added at the top of your portfolio. Check the labels and text, then publish."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is toegevoegd bovenaan je portfolio. Controleer de labels en tekst en publiceer daarna."
          }
        }
      }
    },
    "%@ is toegevoegd. Controleer de gegevens, zet eventueel Tonen in Nieuw en onderweg, Alleen Nederlands of een banner aan, en publiceer als je iets aanpast. De app staat al live met een eigen pagina.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has been added. Check the details, optionally turn on Show in New and upcoming, Dutch only or a banner, and publish if you change anything. The app is already live with its own page."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is toegevoegd. Controleer de gegevens, zet eventueel Tonen in Nieuw en onderweg, Alleen Nederlands of een banner aan, en publiceer als je iets aanpast. De app staat al live met een eigen pagina."
          }
        }
      }
    },
    "%@ staat al in je portfolio": {
      "localizations": {
        "en": {
