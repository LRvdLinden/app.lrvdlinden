    "%@ wordt als bevestigd gemarkeerd, zonder bevestigingsmail. Doe dit alleen als je zeker weet dat dit adres klopt (bijvoorbeeld een review-account). Het wachtwoord blijft van de gebruiker.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ will be marked as confirmed, without a confirmation email. Only do this if you're sure the address is right (for example a review account). The password stays with the user."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wordt als bevestigd gemarkeerd, zonder bevestigingsmail. Doe dit alleen als je zeker weet dat dit adres klopt (bijvoorbeeld een review-account). Het wachtwoord blijft van de gebruiker."
          }
        }
      }
    },
    "%@ wordt permanent verwijderd, met alles wat eraan hangt. Dit kan niet ongedaan worden gemaakt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ will be permanently deleted, along with everything attached to it. This cannot be undone."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wordt permanent verwijderd, met alles wat eraan hangt. Dit kan niet ongedaan worden gemaakt."
          }
        }
      }
    },
