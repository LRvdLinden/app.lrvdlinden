    "NSFaceIDUsageDescription": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "LRbeheer gebruikt Face ID om de app en de beheeromgevingen te ontgrendelen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LRbeheer uses Face ID to unlock the app and the admin environments."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "LRbeheer gebruikt je foto's alleen als je een icoon, banner of afbeelding uploadt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LRbeheer only uses your photos when you upload an icon, banner or image."
          }
        }
      }
    }
